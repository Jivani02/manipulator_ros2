<?xml version="1.0"?>
<sdf version="1.8">
  <world name="table_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
     <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <link name="link">
        <collision name="top_c">
          <pose>0.35 0 0.675 0 0 0</pose>
          <geometry><box><size>1.2 0.9 0.04</size></box></geometry>
        </collision>
        <visual name="top_v">
          <pose>0.35 0 0.68 0 0 0</pose>
          <geometry><box><size>1.2 0.9 0.04</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>

        <collision name="leg1_c">
          <pose>-0.20 0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
        </collision>
        <visual name="leg1_v">
          <pose>-0.20 0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>

        <collision name="leg2_c">
          <pose>-0.20 -0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
        </collision>
        <visual name="leg2_v">
          <pose>-0.20 -0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>

        <collision name="leg3_c">
          <pose>0.90 0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
        </collision>
        <visual name="leg3_v">
          <pose>0.90 0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>

        <collision name="leg4_c">
          <pose>0.90 -0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
        </collision>
        <visual name="leg4_v">
          <pose>0.90 -0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
      <model name="top_camera">
        <static>true</static>
        <pose>0.5 0 1.7 0 1.5708 0</pose>
        <link name="link">
         <sensor name="top_camera" type="camera">
          <camera>
           <horizontal_fov>1.0</horizontal_fov>
           <image><width>640</width><height>480</height><format>R8G8B8</format></image>
           <clip><near>0.1</near><far>5</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>top_camera/image</topic>
         </sensor>
        </link>
     </model>
     
     <model name="cube_red">
      <pose>0.5 0.2 0.72 0 0 0.3</pose>
      <link name="link">
       <inertial>
        <mass>0.1</mass>
        <inertia>
         <ixx>4.17e-5</ixx><iyy>4.17e-5</iyy><izz>4.17e-5</izz>
        </inertia>
       </inertial>
       <collision name="collision">
         <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
       </collision>
       <visual name="visual">
         <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
         <material>
           <ambient>0.8 0 0 1</ambient>
           <diffuse>0.8 0 0 1</diffuse>
         </material>
       </visual>
      </link>
     </model>

  </world>
</sdf>
