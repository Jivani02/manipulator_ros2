<?xml version="1.0"?>
<sdf version="1.8">
  <world name="table_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <link name="link">
        <collision name="top_c">
          <pose>0.35 0 0.675 0 0 0</pose>
          <geometry><box><size>1.2 0.9 0.04</size></box></geometry>
        </collision>
        <visual name="top_v">
          <pose>0.35 0 0.68 0 0 0</pose>
          <geometry><box><size>1.2 0.9 0.04</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>

        <collision name="leg1_c">
          <pose>-0.20 0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
        </collision>
        <visual name="leg1_v">
          <pose>-0.20 0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>

        <collision name="leg2_c">
          <pose>-0.20 -0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
        </collision>
        <visual name="leg2_v">
          <pose>-0.20 -0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>

        <collision name="leg3_c">
          <pose>0.90 0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
        </collision>
        <visual name="leg3_v">
          <pose>0.90 0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>

        <collision name="leg4_c">
          <pose>0.90 -0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
        </collision>
        <visual name="leg4_v">
          <pose>0.90 -0.40 0.33 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.66</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
